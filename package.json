{
  "name": "my-cafe-gourmand",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run content:validate && next build && npm run staticwebapp:generate",
    "preview": "python3 -m http.server 3000 --directory out",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "tsx --test test/*.test.ts",
    "content:validate": "tsx scripts/validate-content.ts",
    "staticwebapp:generate": "tsx scripts/generate-staticwebapp.ts",
    "import:recipe": "tsx scripts/import-wordpress-recipe.ts",
    "inventory:urls": "tsx scripts/inventory-urls.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "fast-xml-parser": "5.10.1",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "tsx": "4.20.6",
    "typescript": "6.0.3"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.25"
    }
  }
}
