        "steps": [
          {
            "sourceIndex": 0,
            "text": "Faire cuire les pommes de terre dans l'eau salée pendant 15 à 20 min à partir de l'ébullition. Égoutter.",
            "mediaId": "wordpress-attachment:19911"
          },
          {
            "sourceIndex": 1,
            "text": "Réduire en purée avec 50 g de beurre. Ajouter le lait réchauffé. Bien mélanger. Goûter la purée et, s'il le faut, rajouter du sel.",
            "mediaId": "wordpress-attachment:19912"
          },
          {
            "sourceIndex": 2,
            "text": "Eplucher et émincer l'oignon et l'ail.",
            "mediaId": "wordpress-attachment:19913"
          },
          {
            "sourceIndex": 3,
            "text": "Dans une poêle, faire fondre le beurre (30 g) et y faire revenir l'oignon et l'ail.",
            "mediaId": "wordpress-attachment:19914"
          },
          {
            "sourceIndex": 4,
            "text": "Ajouter la viande hachée. Saler et poivrer. Bien mélanger et cuire 5-7 minutes. Retirer la poêle du feu et laisser refroidir un peu.",
            "mediaId": "wordpress-attachment:19915"
          },
          {
            "sourceIndex": 5,
            "text": "Ajouter l'œuf et mélanger.",
            "mediaId": "wordpress-attachment:19916"
          },
          {
            "sourceIndex": 6,
            "text": "Mouliner la viande cuite. Goûter et ajuster l'assaisonnement.",
            "mediaId": "wordpress-attachment:19917"
          },
          {
            "sourceIndex": 7,
            "text": "Préchauffer le four à 180°C (thermostat 6). Beurrer un plat allant au four.",
            "mediaId": null
          },
          {
            "sourceIndex": 8,
            "text": "Étaler la moitié des pommes de terre (purée) dans le plat. Recouvrir de viande hachée.\nSaupoudrer d'herbes (paprika, etc)",
            "mediaId": "wordpress-attachment:19918"
          },
          {
            "sourceIndex": 9,
            "text": "Étaler le reste de la purée de pommes de terre par-dessus. Saupoudrer de fromage.",
            "mediaId": "wordpress-attachment:19919"
          },
          {
            "sourceIndex": 10,
            "text": "Cuire au four pendant environ 25 minutes. Servir bien chaud.",
            "mediaId": "wordpress-attachment:19920"
          }
        ]
      }
    ]
