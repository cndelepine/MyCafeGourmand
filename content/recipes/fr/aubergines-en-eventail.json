      {
        "name": null,
        "sourceIndex": 0,
        "steps": [
          {
            "sourceIndex": 0,
            "text": "Éplucher et émincer grossièrement les oignons et l'ail.",
            "mediaId": "wordpress-attachment:15701"
          },
          {
            "sourceIndex": 1,
            "text": "Dans une poêle, faire chauffer 3 cuillères à soupe d'huile d'olive et y faire revenir les oignoins et l'ail. Saler et poivrer.",
            "mediaId": "wordpress-attachment:15702"
          },
          {
            "sourceIndex": 2,
            "text": "Préchauffer le four à 180°C (thermostat 6). Mettre les oignoins dans un plat allant au four.",
            "mediaId": "wordpress-attachment:15703"
          },
          {
            "sourceIndex": 3,
            "text": "Couper les pédoncules. Puis découper les aubergines en lamelles d'1/2 cm de large sans les couper complètement (s’arrêter à 2 cm avant le bout).",
            "mediaId": "wordpress-attachment:15704"
          },
          {
            "sourceIndex": 4,
            "text": "Couper les tomates en rondelles d'1/2 cm de largeur. Saler un peu.",
            "mediaId": "wordpress-attachment:15705"
          },
          {
            "sourceIndex": 5,
            "text": "Insérer les rondelles de tomates dans chaque entaille d'aubergines.",
            "mediaId": "wordpress-attachment:15706"
          },
          {
            "sourceIndex": 6,
            "text": "Poser délicatement les aubergines-tomates sur le lit d'oignons et d'ail. Saler, poivrer encore une fois, ajouter les feuilles de laurier.",
            "mediaId": "wordpress-attachment:15710"
          },
          {
            "sourceIndex": 7,
            "text": "Badigeonner avec le reste d'huile d'olive.",
            "mediaId": "wordpress-attachment:15707"
          },
          {
            "sourceIndex": 8,
            "text": "Faire cuire au four pendant environ 1 heure.",
            "mediaId": "wordpress-attachment:15708"
          }
        ]
