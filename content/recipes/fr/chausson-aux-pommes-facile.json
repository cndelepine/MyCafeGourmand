    "instructionGroups": [
      {
        "name": null,
        "sourceIndex": 0,
        "steps": [
          {
            "sourceIndex": 0,
            "text": "Préchauffer le four à 190°C (thermostat 6/7).",
            "mediaId": null
          },
          {
            "sourceIndex": 1,
            "text": "Étaler la pâte feuilletée. Avec un emporte-pièce, former des cercles de 10-15 cm de diamètre.",
            "mediaId": "wordpress-attachment:27743"
          },
          {
            "sourceIndex": 2,
            "text": "Éplucher la pomme et la couper en fines lamelles.",
            "mediaId": "wordpress-attachment:27742"
          },
          {
            "sourceIndex": 3,
            "text": "Sur chaque cercle, mettre un peu de compote de pommes, puis 2-3 lamelles de pomme et un morceau de beurre. Saupoudrer de sucre.",
            "mediaId": "wordpress-attachment:27744"
          },
          {
            "sourceIndex": 4,
            "text": "Mouiller les bords avec de l'eau.",
            "mediaId": "wordpress-attachment:27745"
          },
          {
            "sourceIndex": 5,
            "text": "Plier le cercle en formant un demi-cercle et bien souder les bords.",
            "mediaId": "wordpress-attachment:27746"
          },
          {
            "sourceIndex": 6,
            "text": "Badigeonner avec l’œuf battu.",
            "mediaId": "wordpress-attachment:27747"
          },
          {
            "sourceIndex": 7,
            "text": "Faire des incisions en forme de grille sur la pâte, sans la découper complètement (facultatif).\n\nAvec un couteau, faire un petit trou dans chaque chausson.",
            "mediaId": "wordpress-attachment:27748"
          },
          {
            "sourceIndex": 8,
            "text": "Cuire au four pendant environ 20 minutes.",
            "mediaId": "wordpress-attachment:27749"
          }
        ]
      }
    ]
