          {
            "sourceIndex": 3,
            "text": "Remettre la casserole sur le feu et faire sécher la pâte en remuant tout le temps pendant 30 à 50 secondes.\nRetirer la casserole du feu.",
            "mediaId": "wordpress-attachment:17771"
          },
          {
            "sourceIndex": 4,
            "text": "Mettre la pâte dans une poche à douille.",
            "mediaId": "wordpress-attachment:17772"
          },
          {
            "sourceIndex": 5,
            "text": "Former des petits tas sur la plaque en les séparant les uns des autres, ils vont doubler de volume pendant la cuisson.",
            "mediaId": "wordpress-attachment:17773"
          },
          {
            "sourceIndex": 6,
            "text": "Dorer le dessus des choux avec le jaune d'œuf.",
            "mediaId": "wordpress-attachment:17774"
          },
          {
            "sourceIndex": 7,
            "text": "Cuire au four pendant 20-25 minutes jusqu’à obtenir une jolie couleur dorée. Sortir les choux du four et les laisser refroidir. Ne pas ouvrir la porte du four pendant la cuisson !",
            "mediaId": "wordpress-attachment:17775"
          }
        ]
      },
      {
        "name": "Mousse au saumon fumé",
        "sourceIndex": 1,
        "steps": [
          {
            "sourceIndex": 0,
            "text": "Dans le bol du robot, mettre le saumon fumé, les échalotes, l'ail, la crème fraîche épaisse et l'huile d'olive. Mixer.",
            "mediaId": "wordpress-attachment:17776"
          },
          {
            "sourceIndex": 1,
            "text": "Saler, poivrer et arroser de jus de citron. Mixer encore un peu.",
            "mediaId": "wordpress-attachment:17777"
          },
          {
            "sourceIndex": 2,
            "text": "Monter la crème froide en chantilly.",
            "mediaId": "wordpress-attachment:17778"
          },
          {
            "sourceIndex": 3,
            "text": "Délicatement incorporer la chantilly à la préparation au saumon en ajoutant l'aneth.",
            "mediaId": "wordpress-attachment:17779"
          },
          {
            "sourceIndex": 4,
            "text": "Couper le haut des petits choux et les garnir avec de la mousse à l'aide d'une poche à douille (ou avec une cuillerée).",
            "mediaId": "wordpress-attachment:17780"
          },
          {
            "sourceIndex": 5,
            "text": "Saupoudrer de paprika. Servir aussitôt ou mettre dans le réfrigérateur.",
            "mediaId": "wordpress-attachment:17781"
          }
        ]
      }
    ]
  },
