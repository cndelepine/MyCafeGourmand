    "instructionGroups": [
      {
        "name": null,
        "sourceIndex": 0,
        "steps": [
          {
            "sourceIndex": 0,
            "text": "Préparer la semoule comme il est indiqué sur l'emballage. (Verser l'eau bouillante sur la semoule. Saler et laisser gonfler pendant 5 minutes). Laisser refroidir.",
            "mediaId": null
          },
          {
            "sourceIndex": 1,
            "text": "Couper les tomates en petits dés.",
            "mediaId": "wordpress-attachment:11544"
          },
          {
            "sourceIndex": 2,
            "text": "Couper le concombre en petits dés. (Si la peau de concombre est épaisse ou en peu amère, éplucher).",
            "mediaId": "wordpress-attachment:11546"
          },
          {
            "sourceIndex": 3,
            "text": "Couper l'oignon en petits dés.",
            "mediaId": "wordpress-attachment:11545"
          },
          {
            "sourceIndex": 4,
            "text": "Couper les poivrons en deux, les épépiner puis couper en petits dés.",
            "mediaId": "wordpress-attachment:11547"
          },
          {
            "sourceIndex": 5,
            "text": "Ciseler les feuilles de menthe et de persil.",
            "mediaId": "wordpress-attachment:11548"
          },
          {
            "sourceIndex": 6,
            "text": "Dans un grand saladier, mélanger la semoule, les légumes découpés et les herbes. Saler et povrer. Si vous aimez les plats épicés, ajouter la sauce Tabasco. Saler, poivrer. Arroser de jus de citron fraîchement pressé et d'huile d'olive. Couvrir avec du film plastique et laisser reposer au réfrigérateur pendant au moins 3 heures.",
            "mediaId": "wordpress-attachment:11549"
          },
          {
            "sourceIndex": 7,
            "text": "Pour une présentation plus sophistiquée, utiliser un cercle et faire un service à l'assiette.",
            "mediaId": "wordpress-attachment:11560"
          },
          {
            "sourceIndex": 8,
            "text": "Pour un appéritif dinatoire, servir dans des verrines.",
            "mediaId": "wordpress-attachment:11551"
          },
          {
            "sourceIndex": 9,
            "text": "Ou encore farcir des tomates.",
            "mediaId": "wordpress-attachment:11550"
          }
        ]
      }
    ]
  },
