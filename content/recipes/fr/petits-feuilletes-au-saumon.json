    "instructionGroups": [
      {
        "name": null,
        "sourceIndex": 0,
        "steps": [
          {
            "sourceIndex": 0,
            "text": "Dans une poêle, faire revenir l'oignon dans l'huile d'olive.",
            "mediaId": "wordpress-attachment:13009"
          },
          {
            "sourceIndex": 1,
            "text": "Dans un saladier, mélanger le saumon, l'oignon, la crème fraîche et l'aneth. Saler et poivrer.",
            "mediaId": "wordpress-attachment:13010"
          },
          {
            "sourceIndex": 2,
            "text": "Préchauffer le four à 180°C (thermostat 6). Tapisser une plaque de papier sulfurisé.",
            "mediaId": null
          },
          {
            "sourceIndex": 3,
            "text": "Sur le plan de travail, étaler la pâte et découper des ronds de 6-8 cm.",
            "mediaId": "wordpress-attachment:13011"
          },
          {
            "sourceIndex": 4,
            "text": "Placer une cuillerée de la préparation au saumon sur la moitié de ronds.",
            "mediaId": "wordpress-attachment:13012"
          },
          {
            "sourceIndex": 5,
            "text": "Humecter les bords et placer les autres ronds dessus. Bien sceller.",
            "mediaId": "wordpress-attachment:13013"
          },
          {
            "sourceIndex": 6,
            "text": "Placer les petits feuilletés sur la plaque. Faire un petit trou dans chaque. Badigeonner avec l'oeuf battu.",
            "mediaId": "wordpress-attachment:13014"
          },
          {
            "sourceIndex": 7,
            "text": "Percer un petit trou dans chaque feuilleté. Si vous voulez, avec la lame d'un couteau, faire un dessin sur la surface de la pâte, sans la percer.",
            "mediaId": "wordpress-attachment:13015"
          },
          {
            "sourceIndex": 8,
            "text": "Faire cuire au four pendant environ 20 minutes.",
            "mediaId": "wordpress-attachment:13017"
          }
        ]
      }
    ]
  },
