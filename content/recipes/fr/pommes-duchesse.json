    "instructionGroups": [
      {
        "name": null,
        "sourceIndex": 0,
        "steps": [
          {
            "sourceIndex": 0,
            "text": "Eplucher les pommes de terre, couper en morceaux et cuire dans l'eau salée. Une fois les pommes cuites (vérifier avec un couteau ou une fourchette), retirer immédiatement l'eau.",
            "mediaId": "wordpress-attachment:4322"
          },
          {
            "sourceIndex": 1,
            "text": "Ecraser les pommes de terre encore chaudes en purée et ajouter le beurre.\n\nSaler, poivrer et ajouter un peu de noix de muscade.",
            "mediaId": "wordpress-attachment:26632"
          },
          {
            "sourceIndex": 2,
            "text": "Ajouter les jaunes d'œuf et mélanger très bien. La purée doit être onctueuse sans morceau.",
            "mediaId": "wordpress-attachment:26633"
          },
          {
            "sourceIndex": 3,
            "text": "Chauffer le four à 200C. Mettre du papier sulfurisé ou un tapis silicone sur un plat de cuisson.",
            "mediaId": null
          },
          {
            "sourceIndex": 4,
            "text": "Transférer la purée dans une poche à douille avec un embout en forme d'étoile et créer des roses de la taille désirée sur le plat de cuisson.",
            "mediaId": "wordpress-attachment:26634"
          },
          {
            "sourceIndex": 5,
            "text": "Cuire dans le four préchauffé pendant environ 10 minutes, jusqu'à obtenir une jolie couleur dorée.",
            "mediaId": "wordpress-attachment:26635"
          }
        ]
      }
    ]
