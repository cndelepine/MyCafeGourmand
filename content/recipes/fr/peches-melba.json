        "steps": [
          {
            "sourceIndex": 0,
            "text": "Préchauffer le four à 180°C (thermostat 6). Tapisser une plaque à pâtisserie avec du papier sulfurisé.",
            "mediaId": null
          },
          {
            "sourceIndex": 1,
            "text": "Couper les pêches en deux et retirer les noyaux. Placer les demi-pêches sur la plaque, saupoudrer de sucre et faire cuire au four pendant environ 35 minutes.",
            "mediaId": "wordpress-attachment:17872"
          },
          {
            "sourceIndex": 2,
            "text": "Les pêches doivent devenir tendres mais encore garder leur forme. Retirer la plaque du four, laisser refroidir les pêches puis enlever la peau.",
            "mediaId": "wordpress-attachment:17873"
          },
          {
            "sourceIndex": 3,
            "text": "Réduire les fruits rouges en purée à l'aide d'un blender. Passer au tamis pour enlever toutes les petites graines et obtenir un coulis bien lisse.",
            "mediaId": "wordpress-attachment:18080"
          },
          {
            "sourceIndex": 4,
            "text": "Ajouter le sucre en poudre dans la crème liquide. Monter la crème en chantilly.",
            "mediaId": "wordpress-attachment:13109"
          },
          {
            "sourceIndex": 5,
            "text": "Dans une coupe à glace (ou un simple verre), déposer une demi-pêche et une boule de glace.",
            "mediaId": "wordpress-attachment:17874"
          },
          {
            "sourceIndex": 6,
            "text": "Napper de coulis.",
            "mediaId": "wordpress-attachment:17875"
          },
          {
            "sourceIndex": 7,
            "text": "Ajouter un peu de chantilly et terminer par le chocolat et les amandes. Servir aussitôt.",
            "mediaId": "wordpress-attachment:17876"
          }
        ]
      }
    ]
