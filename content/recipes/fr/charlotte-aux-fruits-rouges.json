          },
          {
            "sourceIndex": 14,
            "text": "Saupoudrer de cacao.",
            "mediaId": "wordpress-attachment:4867"
          },
          {
            "sourceIndex": 15,
            "text": "Décorer avec les fruits, les feuilles de menthe et la chantilly.",
            "mediaId": "wordpress-attachment:4851"
          },
          {
            "sourceIndex": 16,
            "text": "Si vous voulez, enlacer le gâteau avec un ruban.",
            "mediaId": "wordpress-attachment:4868"
          }
        ]
      }
    ]
  },
