        "steps": [
          {
            "sourceIndex": 0,
            "text": "Préchauffer le four à 175°C (thermostat 6), beurrer et fariner un moule.",
            "mediaId": null
          },
          {
            "sourceIndex": 1,
            "text": "Hacher finement les noix.",
            "mediaId": "wordpress-attachment:18704"
          },
          {
            "sourceIndex": 2,
            "text": "Dans un saladier, battre le beurre et le sucre.",
            "mediaId": "wordpress-attachment:18702"
          },
          {
            "sourceIndex": 3,
            "text": "Ajouter les œufs.",
            "mediaId": "wordpress-attachment:18703"
          },
          {
            "sourceIndex": 4,
            "text": "Puis la farine avec la levure chimique. Bien mélanger.",
            "mediaId": "wordpress-attachment:18705"
          },
          {
            "sourceIndex": 5,
            "text": "Incorporer les noix hachées.",
            "mediaId": "wordpress-attachment:18707"
          },
          {
            "sourceIndex": 6,
            "text": "Ajouter les raisins secs et mélanger avec une spatule.",
            "mediaId": "wordpress-attachment:18708"
          },
          {
            "sourceIndex": 7,
            "text": "Verser la pâte dans le moule et égaliser la surface.",
            "mediaId": "wordpress-attachment:18709"
          },
          {
            "sourceIndex": 8,
            "text": "Cuire au four pendant environ 45 minutes. Sortir le gâteau du four. Laisser refroidir un peu.",
            "mediaId": "wordpress-attachment:18710"
          },
          {
            "sourceIndex": 9,
            "text": "Démouler sur un plat de présentation. Saupoudrer de sucre glace.",
            "mediaId": "wordpress-attachment:18711"
          }
        ]
      }
