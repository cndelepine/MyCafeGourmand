        "steps": [
          {
            "sourceIndex": 0,
            "text": "Couper le chapeau de chaque clémentine",
            "mediaId": "wordpress-attachment:26094"
          },
          {
            "sourceIndex": 1,
            "text": "Enlever délicatement la chair sans abîmer la peau de la clémentine",
            "mediaId": "wordpress-attachment:26095"
          },
          {
            "sourceIndex": 2,
            "text": "Réserver la peau. Gardez-la dans un papier absorbant humidifié.",
            "mediaId": "wordpress-attachment:26097"
          },
          {
            "sourceIndex": 3,
            "text": "Verser la chair des clémentines dans un bol. Ajouter le miel et le Grand Marnier.\n\nMixer à l'aide d'un blender",
            "mediaId": "wordpress-attachment:26096"
          },
          {
            "sourceIndex": 4,
            "text": "Filtrer",
            "mediaId": "wordpress-attachment:26098"
          },
          {
            "sourceIndex": 5,
            "text": "Couvrir la préparation et mettre au congélateur pendant environ 4 heures.",
            "mediaId": "wordpress-attachment:26099"
          },
          {
            "sourceIndex": 6,
            "text": "Sortir du congélateur et mélanger la préparation congelée avec une fourchette.",
            "mediaId": "wordpress-attachment:26100"
          },
          {
            "sourceIndex": 7,
            "text": "Verser la préparation glacée dans chaque clémentine évidée.",
            "mediaId": "wordpress-attachment:26101"
          },
          {
            "sourceIndex": 8,
            "text": "Remettre le chapeau pour une jolie présentation.\n\nServir et déguster!",
            "mediaId": "wordpress-attachment:26102"
          }
        ]
      }
