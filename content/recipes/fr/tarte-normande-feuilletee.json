          {
            "sourceIndex": 0,
            "text": "Préchauffer le four à 180°C (thermostat 6). Dérouler la pâte et foncer un moule à tarte tapissé de papier sulfurisé. Piquer la pâte avec une fourchette.",
            "mediaId": null
          },
          {
            "sourceIndex": 1,
            "text": "Recouvrir la pâte de papier sulfurisé puis de haricots secs ou de lentilles pour qu’elle ne gonfle pas pendant la cuisson. Faire cuire à blanc pendant 12-15 minutes. (Je n'utilise pas le poids, si la pâte gonfle pendant la cuisson, je l'aplatis avec une cuillère.)",
            "mediaId": null
          },
          {
            "sourceIndex": 2,
            "text": "Éplucher et épépiner les pommes. Les découper en très fines lamelles et arroser de jus de citron.",
            "mediaId": null
          },
          {
            "sourceIndex": 3,
            "text": "Disposer joliment les pommes sur la pâte précuite.",
            "mediaId": null
          },
          {
            "sourceIndex": 4,
            "text": "Battre les œufs et le sucre. Ajouter le calvados, la crème fraîche et la poudre d'amandes.",
            "mediaId": null
          },
          {
            "sourceIndex": 5,
            "text": "Verser cette préparation sur les pommes.",
            "mediaId": null
          },
          {
            "sourceIndex": 6,
            "text": "Cuire au four pendant environ 15 minutes.",
            "mediaId": null
          },
          {
            "sourceIndex": 7,
            "text": "Saupoudrer la tarte avec les amandes éffilées.",
            "mediaId": null
          },
          {
            "sourceIndex": 8,
            "text": "Remettre au four et cuire encore environ 30 minutes jusqu’à l'apparition d'une belle croûte dorée. Laisser refroidir la tart puis saupoudrer de sucre glace",
            "mediaId": "wordpress-attachment:1050"
          }
        ]
      }
