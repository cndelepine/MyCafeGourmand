        "steps": [
          {
            "sourceIndex": 0,
            "text": "Préchauffer le four à 180C (360F).\n\nTapisser le fond d'un moule à gâteau avec du papier sulfurisé et beurrer bien les bords du moule.",
            "mediaId": null
          },
          {
            "sourceIndex": 1,
            "text": "Dans un bol à mixeur, battre les œufs avec le sucre en ajoutant le sel et la vanille.",
            "mediaId": "wordpress-attachment:25755"
          },
          {
            "sourceIndex": 2,
            "text": "Hacher les noix.",
            "mediaId": "wordpress-attachment:25756"
          },
          {
            "sourceIndex": 3,
            "text": "Ajouter les noix hachées, la fariné tamisée et la levure dans le bol du mixeur.",
            "mediaId": "wordpress-attachment:25757"
          },
          {
            "sourceIndex": 4,
            "text": "Ajouter les cerises et mélanger délicatement.",
            "mediaId": "wordpress-attachment:25758"
          },
          {
            "sourceIndex": 5,
            "text": "Verser la pâte dans le moule",
            "mediaId": "wordpress-attachment:25759"
          },
          {
            "sourceIndex": 6,
            "text": "Cuire au four pendant environ 1 heure ou plus, jusqu'à ce que la pointe d'un couteau ressorte propre de la pâte.",
            "mediaId": "wordpress-attachment:25760"
          },
          {
            "sourceIndex": 7,
            "text": "Sortir du four, démouler et laisser refroidir avant de découper et servir le gâteau.",
            "mediaId": "wordpress-attachment:25762"
          }
        ]
      }
