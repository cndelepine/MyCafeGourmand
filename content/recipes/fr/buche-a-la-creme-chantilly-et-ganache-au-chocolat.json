    "instructionGroups": [
      {
        "name": "Sirop de sucre",
        "sourceIndex": 0,
        "steps": [
          {
            "sourceIndex": 0,
            "text": "Dans une petite casserole, mettre le sucre et l'eau. Porter à ébullition et laisser cuire pendant quelques minutes. Retirer la casserole du feu. Laisser refroidir. Ajouter éventuellement la vanille ou le Grand-Marnier.",
            "mediaId": "wordpress-attachment:13289"
          }
        ]
      },
      {
        "name": "Biscuit au chocolat",
        "sourceIndex": 1,
        "steps": [
          {
            "sourceIndex": 0,
            "text": "Préchauffer le four à 180°C (thermostat 6). Tapisser une grande plaque à pâtisserie avec une feuille de papier sulfurisé.",
            "mediaId": null
          },
          {
            "sourceIndex": 1,
            "text": "Battre les œufs avec le sucre. La préparation doit tripler le volume.",
            "mediaId": "wordpress-attachment:13287"
          },
          {
            "sourceIndex": 2,
            "text": "Ajouter la farine et le cacao tamisés. Mélanger délicatement avec une maryse.",
            "mediaId": "wordpress-attachment:13274"
          },
          {
            "sourceIndex": 3,
            "text": "Verser la pâte sur la plaque recouverte de papier sulfurisé, égaliser la surface et faire cuire au four pendant 7 à 8 minutes.",
            "mediaId": "wordpress-attachment:13275"
          },
          {
            "sourceIndex": 4,
            "text": "Sortir le biscuit du four, le retourner sur une autre grande feuille de papier sulfurisé, retirer le papier de cuisson. Couvrir avec un torchon propre et laisser refroidir.",
            "mediaId": "wordpress-attachment:13292"
          }
        ]
      },
      {
        "name": "Ganache au chocolat",
        "sourceIndex": 2,
        "steps": [
          {
            "sourceIndex": 0,
            "text": "Faire bouillir la crème liquide et la verser sur le chocolat. Attendre 1 minute.",
            "mediaId": "wordpress-attachment:13286"
          },
          {
            "sourceIndex": 1,
            "text": "Mélanger pour obtenir une préparation homogène.",
            "mediaId": "wordpress-attachment:13290"
          },
          {
            "sourceIndex": 2,
            "text": "Ajouter le beurre et bien mélanger.",
            "mediaId": "wordpress-attachment:13291"
          },
          {
            "sourceIndex": 3,
            "text": "Laisser la ganache refroidir pendant environ 30 minutes au réfrigérateur. Mélanger régulièrement pour vérifier la consistence de la ganache : elle ne doit plus être liquide mais rester souple.",
            "mediaId": null
          }
        ]
      },
      {
        "name": "Crème chantilly",
        "sourceIndex": 3,
        "steps": [
          {
            "sourceIndex": 0,
            "text": "Dans une jatte, mettre en même temps la crème liquide froide et le mascarpone froid. Battre en chantilly en ajoutant le sucre en poudre.",
            "mediaId": "wordpress-attachment:13277"
          }
        ]
      },
      {
        "name": "Assemblage",
        "sourceIndex": 4,
        "steps": [
          {
            "sourceIndex": 0,
            "text": "Badigeonner le biscuit avec le sirop de sucre.",
            "mediaId": "wordpress-attachment:13276"
          },
          {
            "sourceIndex": 1,
            "text": "Étaler la crème chantilly sur toute la surface du biscuit.",
            "mediaId": "wordpress-attachment:13278"
          },
          {
            "sourceIndex": 2,
            "text": "Enrouler.",
            "mediaId": "wordpress-attachment:13279"
          },
          {
            "sourceIndex": 3,
            "text": "L'envelopper dans un film plastique alimentaire en serrant bien. Placer au réfrigérateur en attendant que la ganache au chocolat soit prête à étaler.",
            "mediaId": "wordpress-attachment:13280"
          },
          {
            "sourceIndex": 4,
            "text": "Sortir la bûche du réfrigérateur, enlever le film plastique et placer la bûche sur un plat de service. Étaler la ganache sur toute la surface de gâteau en formant le relief de la bûche en faisant des rainures avec une fourchette, par exemple. Remettre le dessert au réfrigérateur pendant environ 6 heures.",
            "mediaId": "wordpress-attachment:13281"
          },
          {
            "sourceIndex": 5,
            "text": "Avant de servir, saupoudrer la bûche de sucre glace et/ou de cacao amer et décorer avec des petites figurines de Noël, des meringues ou des chocolats.",
            "mediaId": "wordpress-attachment:13283"
          }
        ]
      }
    ]
  },
