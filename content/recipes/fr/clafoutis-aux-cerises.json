        "steps": [
          {
            "sourceIndex": 0,
            "text": "Préchauffer le four a 210°С.",
            "mediaId": null
          },
          {
            "sourceIndex": 1,
            "text": "Mélanger les œufs et le sucre.",
            "mediaId": "wordpress-attachment:24787"
          },
          {
            "sourceIndex": 2,
            "text": "Ajouter le lait, la crème liquide. Mélanger.",
            "mediaId": "wordpress-attachment:24798"
          },
          {
            "sourceIndex": 3,
            "text": "Ajouter la vanille.",
            "mediaId": "wordpress-attachment:24799"
          },
          {
            "sourceIndex": 4,
            "text": "Ajouter la farine et le sel. Bien mélanger encore une fois.",
            "mediaId": "wordpress-attachment:24800"
          },
          {
            "sourceIndex": 5,
            "text": "Beurrer généreusement le(s) moule(s) allant au four et les saupoudrer de sucre.",
            "mediaId": "wordpress-attachment:24801"
          },
          {
            "sourceIndex": 6,
            "text": "Répartir les cerises dénoyautées au fond des moules.",
            "mediaId": "wordpress-attachment:24802"
          },
          {
            "sourceIndex": 7,
            "text": "Verser la pâte à clafoutis. Les cerises doivent rester visibles.",
            "mediaId": "wordpress-attachment:24803"
          },
          {
            "sourceIndex": 8,
            "text": "Faire cuire au four pendant 30-40 minutes. Le temps de la cuisson dépend de la taille des moules.",
