        "steps": [
          {
            "sourceIndex": 0,
            "text": "Preheat the oven to 190°C (thermostat 6).\n\nLine a large pan (24 cm) with 2 layers of parchment paper.",
            "mediaId": "wordpress-attachment:26529"
          },
          {
            "sourceIndex": 1,
            "text": "In a mixer bowl, beat the Philadelphia cheese at low speed with the sugar, adding the salt.",
            "mediaId": "wordpress-attachment:26522"
          },
          {
            "sourceIndex": 2,
            "text": "Add the heavy cream and vanilla. Continue mixing at low speed.",
            "mediaId": "wordpress-attachment:26523"
          },
          {
            "sourceIndex": 3,
            "text": "Add the eggs one by one, mixing well after each addition, still on low speed.",
            "mediaId": "wordpress-attachment:26525"
          },
          {
            "sourceIndex": 4,
            "text": "Add the flour and mix once more.",
            "mediaId": "wordpress-attachment:26526"
          },
          {
            "sourceIndex": 5,
            "text": "Pour the batter into the prepared pan.",
            "mediaId": null
          },
          {
            "sourceIndex": 6,
            "text": "Bake in the oven for about 60 minutes. The cake will rise, develop a nice golden crust, but remain slightly wobbly in the center.",
            "mediaId": "wordpress-attachment:26531"
          },
          {
            "sourceIndex": 7,
            "text": "Remove the cake from the oven. Let it cool for about 2 hours, then unmold it onto a serving plate. As it cools, the cake will deflate.",
            "mediaId": "wordpress-attachment:26532"
          },
          {
            "sourceIndex": 8,
            "text": "Serve at room temperature with syruped cherries or enjoy it plain.",
            "mediaId": "wordpress-attachment:26528"
          }
        ]
      }
    ]
