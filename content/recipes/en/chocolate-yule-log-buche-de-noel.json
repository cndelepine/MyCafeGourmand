          {
            "sourceIndex": 3,
            "text": "Spread the batter evenly in thin layer into the prepared baking sheet. Bake for 7 to 8 minutes in the preheated oven until a toothpick inserted in center of biscuit comes out clean.",
            "mediaId": "wordpress-attachment:13275"
          },
          {
            "sourceIndex": 4,
            "text": "Turn upside down onto clean kitchen towel and carefully remove parchment paper. Let cool down.",
            "mediaId": "wordpress-attachment:13292"
          }
        ]
      },
      {
        "name": "Chocolate ganache",
        "sourceIndex": 2,
        "steps": [
          {
            "sourceIndex": 0,
            "text": "Boil the heavy whipping cream. Pour the boiling cream over the dark chocolate. Wait for one minute.",
            "mediaId": "wordpress-attachment:13286"
          },
          {
            "sourceIndex": 1,
            "text": "Then mix it until the mixture is smooth.",
            "mediaId": "wordpress-attachment:13290"
          },
          {
            "sourceIndex": 2,
            "text": "Add butter and mix until this is fully dissolved.",
            "mediaId": "wordpress-attachment:13291"
          },
          {
            "sourceIndex": 3,
            "text": "Let cool the ganache for about 30 minutes in the fridge. Mix and check frequently: the ganache is ready when it's not anymore liquid and has a spreadable texture.",
            "mediaId": null
          }
        ]
      },
      {
        "name": "Chantilly cream",
        "sourceIndex": 3,
        "steps": [
          {
            "sourceIndex": 0,
            "text": "Beat together very cold heavy cream and cold mascarpone cheese until this is whipped. Keep gradually adding sugar.",
            "mediaId": "wordpress-attachment:13277"
          }
        ]
      },
      {
        "name": "Assemblage",
        "sourceIndex": 4,
        "steps": [
          {
            "sourceIndex": 0,
            "text": "Paint the biscuit with sugar syrup.",
            "mediaId": "wordpress-attachment:13276"
          },
          {
            "sourceIndex": 1,
            "text": "Spread the chantilly cream evenly over the biscuit.",
            "mediaId": "wordpress-attachment:13278"
          },
          {
            "sourceIndex": 2,
            "text": "Roll up firmly.",
            "mediaId": "wordpress-attachment:13279"
          },
          {
            "sourceIndex": 3,
            "text": "Tightly cover with plastic wrap, and keep in the fridge until chocolate ganache is ready.",
            "mediaId": "wordpress-attachment:13280"
          },
          {
            "sourceIndex": 4,
            "text": "Remove the plastic wrap. Spread the ganache over the cake. Using a fork make lines to look like a log. Transfer the cake to a serving platter and let stand in the fridge for a night or at least 3 hours.",
            "mediaId": "wordpress-attachment:13281"
          },
          {
            "sourceIndex": 5,
            "text": "Before serving, dust with cacao cocoa powder and decorate with meringues or pieces of chocolate.",
            "mediaId": "wordpress-attachment:13283"
          }
        ]
      }
    ]
  },
