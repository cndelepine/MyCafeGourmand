        "steps": [
          {
            "sourceIndex": 0,
            "text": "Preheat oven to 375 degrees F. Lay the puff pastry out on a baking sheet. Prick all over with a fork.",
            "mediaId": "wordpress-attachment:3358"
          },
          {
            "sourceIndex": 1,
            "text": "Pop in the oven for 10-12 minutes or until the crust starts to turn light gold. Remove the pastry from the oven, pressing the center down with a fork, if it puffed up a bit.",
            "mediaId": "wordpress-attachment:3360"
          },
          {
            "sourceIndex": 2,
            "text": "Meanwhile mix tuna and mayonnaise with fork. Season with salt and pepper.",
            "mediaId": "wordpress-attachment:3357"
          },
          {
            "sourceIndex": 3,
            "text": "Spread the mustard across centre. (I use mustard \"a l'ancienne).",
            "mediaId": "wordpress-attachment:3361"
          },
          {
            "sourceIndex": 4,
            "text": "Spoon the tuna mix on top.",
            "mediaId": "wordpress-attachment:3362"
          },
          {
            "sourceIndex": 5,
            "text": "Combine eggs with sour cream and mix together. Season with salt and pepper.",
            "mediaId": "wordpress-attachment:3359"
          },
          {
            "sourceIndex": 6,
            "text": "Pour over tuna.",
            "mediaId": "wordpress-attachment:3363"
          },
          {
            "sourceIndex": 7,
            "text": "Slice tomato and arrange them on top of your quiche. Sprinkle with cheese.",
            "mediaId": "wordpress-attachment:3364"
          },
          {
            "sourceIndex": 8,
            "text": "Bake for 30 minutes or until quiche is golden brown.",
            "mediaId": "wordpress-attachment:3365"
          }
        ]
      }
    ]
