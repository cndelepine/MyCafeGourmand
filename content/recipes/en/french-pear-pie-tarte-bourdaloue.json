          },
          {
            "sourceIndex": 1,
            "text": "Add egg and liquid vanilla.",
            "mediaId": "wordpress-attachment:21016"
          },
          {
            "sourceIndex": 2,
            "text": "Mix everything very quickly to form a ball. The dough is now ready.",
            "mediaId": "wordpress-attachment:20867"
          },
          {
            "sourceIndex": 3,
            "text": "Wrap the dough in plastic wrap and refrigerate for 1 hour, or freeze if you won't bake it in the next few days.",
            "mediaId": "wordpress-attachment:20870"
          }
        ]
      },
      {
        "name": "Almond cream",
        "sourceIndex": 1,
        "steps": [
          {
            "sourceIndex": 0,
            "text": "Beat butter and sugar with a mixer. Add eggs, cream and almond powder.",
            "mediaId": "wordpress-attachment:13250"
          }
        ]
      },
      {
        "name": "Preparing the pie",
        "sourceIndex": 2,
        "steps": [
          {
            "sourceIndex": 0,
            "text": "Preheat the oven to 370F. Roll out the dough between 2 layers of parchment paper.",
            "mediaId": "wordpress-attachment:12434"
          },
          {
            "sourceIndex": 1,
            "text": "Transfer the dough to a pan, press it down and on the sides of the pan. Cut the excess dough. Poke holes on the entire surface with a fork.",
            "mediaId": "wordpress-attachment:12680"
          },
          {
            "sourceIndex": 2,
            "text": "Spread the almond cream evenly over the dough.",
            "mediaId": "wordpress-attachment:21012"
          },
          {
            "sourceIndex": 3,
            "text": "Peel the pears and cut them in half. Remove the seeds. Cut into regular thin slices.",
            "mediaId": "wordpress-attachment:21013"
          },
          {
            "sourceIndex": 4,
            "text": "Arrange the pear slices nicely. Brush with melted butter and sprinkle with almonds.",
            "mediaId": "wordpress-attachment:21014"
          },
          {
            "sourceIndex": 5,
            "text": "Bake for about 40 minutes until golden brown. Remove pie from oven and cool. You can sprinkle lightly with icing sugar before serving.",
