      {
        "name": "Brownie Batter",
        "sourceIndex": 0,
        "steps": [
          {
            "sourceIndex": 0,
            "text": "Preheat the oven to 180°C (350°F). Grease and flour a baking pan.",
            "mediaId": null
          },
          {
            "sourceIndex": 1,
            "text": "Melt the chocolate and butter using a double boiler or microwave, stirring until smooth.",
            "mediaId": "wordpress-attachment:3427"
          },
          {
            "sourceIndex": 2,
            "text": "Add the powdered sugar and mix well.",
            "mediaId": "wordpress-attachment:29242"
          },
          {
            "sourceIndex": 3,
            "text": "Incorporate the eggs one by one, stirring thoroughly after each addition.",
            "mediaId": "wordpress-attachment:29243"
          },
          {
            "sourceIndex": 4,
            "text": "Add the flour and gently mix it in.",
            "mediaId": "wordpress-attachment:29244"
          },
          {
            "sourceIndex": 5,
            "text": "Pour the brownie batter into the prepared baking pan.",
            "mediaId": "wordpress-attachment:29245"
          }
        ]
      },
      {
        "name": "Cookie Dough",
        "sourceIndex": 1,
        "steps": [
          {
            "sourceIndex": 0,
            "text": "In a large bowl, use a mixer to beat the butter, brown sugar, powdered sugar, and vanilla extract until creamy.",
            "mediaId": "wordpress-attachment:8337"
          },
          {
            "sourceIndex": 1,
            "text": "Add the egg and mix again.",
            "mediaId": "wordpress-attachment:8339"
          },
          {
            "sourceIndex": 2,
            "text": "Gradually incorporate the flour mixed with baking soda and salt",
