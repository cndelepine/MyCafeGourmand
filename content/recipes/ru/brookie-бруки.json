    "instructionGroups": [
      {
        "name": "Тесто для брауни",
        "sourceIndex": 0,
        "steps": [
          {
            "sourceIndex": 0,
            "text": "Разогреть духовку до 180°C (термостат 6). Форму для выпечки смазать маслом и присыпать мукой.",
            "mediaId": null
          },
          {
            "sourceIndex": 1,
            "text": "Шоколад и кусочки сливочного масла растопить в микроволновке или на водяной бане. Хорошо перемешать до однородной массы.",
            "mediaId": "wordpress-attachment:3427"
          },
          {
            "sourceIndex": 2,
            "text": "Добавить сахар и снова хорошо перемешать.",
            "mediaId": "wordpress-attachment:29242"
          },
          {
            "sourceIndex": 3,
            "text": "По одному, добавить яйца.",
            "mediaId": "wordpress-attachment:29243"
          },
          {
            "sourceIndex": 4,
            "text": "Добавить просеянную муку и хорошо перемешать последний раз.",
            "mediaId": "wordpress-attachment:29244"
          },
          {
            "sourceIndex": 5,
            "text": "Вылить тесто в подготовленную форму.",
            "mediaId": "wordpress-attachment:29245"
          }
        ]
      },
      {
        "name": "Тесто для печенья (кукис)",
        "sourceIndex": 1,
        "steps": [
          {
            "sourceIndex": 0,
            "text": "Миксером взбить масло с коричневым, белым и ванильным сахаром.",
            "mediaId": "wordpress-attachment:8337"
          },
          {
            "sourceIndex": 1,
            "text": "Добавить яйцо.",
            "mediaId": "wordpress-attachment:8339"
          },
          {
            "sourceIndex": 2,
            "text": "Понемногу добавить муку, смешанную с солью и содой.",
            "mediaId": "wordpress-attachment:8340"
          },
          {
            "sourceIndex": 3,
            "text": "Добавить шоколадные капли и хорошо перемешать лопаткой.",
            "mediaId": "wordpress-attachment:8341"
          },
          {
            "sourceIndex": 4,
            "text": "Равномерно распределить тесто для печенья в форму поверх шоколадного теста для брауни.",
            "mediaId": "wordpress-attachment:29246"
          },
          {
            "sourceIndex": 5,
            "text": "Выпекать в разогретой духовке примерно 20 минут. Проверить на готовность лезвием ножа: шоколадная часть должно быть слегка влажной, но не жидкой, а поверхность выпечки - подрумяниться и стать хрустящей.",
            "mediaId": "wordpress-attachment:29247"
          },
          {
            "sourceIndex": 6,
            "text": "Дать десерту остыть перед тем, как вынуть из формы и нарезать на порции.",
            "mediaId": "wordpress-attachment:29249"
          }
        ]
      }
    ]
  },
