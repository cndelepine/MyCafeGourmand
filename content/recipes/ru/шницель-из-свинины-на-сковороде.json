    "instructionGroups": [
      {
        "name": null,
        "sourceIndex": 0,
        "steps": [
          {
            "sourceIndex": 0,
            "text": "Кусочки мяса накрыть пищевой пленкой и хорошо отбить кулинарным молоточком.",
            "mediaId": null
          },
          {
            "sourceIndex": 1,
            "text": "Подготовить 4 больших тарелки:\nНа первую положить муку, смешанную с солью и перцем.\nНа вторую (глубокую) - взбитые с молоком яйца.\nНа третью - панировочные сухари, смешанные с паприкой.\nИ четвертая, пустая тарелка для готовых шницелей.",
            "mediaId": null
          },
          {
            "sourceIndex": 2,
            "text": "Каждый кусочек мяса обмакнуть в яично-молочную смесь.",
            "mediaId": "wordpress-attachment:6533"
          },
          {
            "sourceIndex": 3,
            "text": "Затем в муку.",
            "mediaId": "wordpress-attachment:6535"
          },
          {
            "sourceIndex": 4,
            "text": "Снова в яично-молочную смесь.",
            "mediaId": "wordpress-attachment:6536"
          },
          {
            "sourceIndex": 5,
            "text": "И, наконец, в панировочные сухари.",
            "mediaId": "wordpress-attachment:6537"
          },
          {
            "sourceIndex": 6,
            "text": "В большой сковороде разогреть достаточное количество оливкового масла и обжарить каждый кусочек мяса до золотистой корочки, примерно 3 минуты с каждой стороны.",
            "mediaId": null
          },
          {
            "sourceIndex": 7,
            "text": "Готовые шницели положить в подготовленную 4-ую тарелку и промокнуть бумажным полотенцем.",
            "mediaId": null
          },
          {
            "sourceIndex": 8,
            "text": "Подать на стол в горячем виде с кружочками лимона. Можно украсить свежей петрушкой.",
            "mediaId": null
          }
        ]
      }
    ]
  },
