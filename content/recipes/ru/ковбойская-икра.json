        "steps": [
          {
            "sourceIndex": 0,
            "text": "Слить жидкость из фасоли и кукурузы. Лук почистить и мелко порезать. У болгарского перца и у острого перчика удалить семена. Болгарский перец порезать кубиками, острый - очень маленькими кубиками. Помодоры порезать кубиками. Мелко порубить кинзу.",
            "mediaId": null
          },
          {
            "sourceIndex": 1,
            "text": "В салатнице хорошо перемешать все ингредиенты. Накрыть пищевой пленкой и дайть постоять 1 час в холодильнике.",
            "mediaId": null
          }
        ]
      }
