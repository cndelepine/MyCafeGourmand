    "instructionGroups": [
      {
        "name": null,
        "sourceIndex": 0,
        "steps": [
          {
            "sourceIndex": 0,
            "text": "Филе мяса накрыть пищевой пленкой и хорошо отбить.",
            "mediaId": "wordpress-attachment:13040"
          },
          {
            "sourceIndex": 1,
            "text": "Посолить, поперчить и посыпать паприкой с обоих сторон. Слегка обвалять в панировочных сухарях.",
            "mediaId": "wordpress-attachment:13041"
          },
          {
            "sourceIndex": 2,
            "text": "В большой сковороде разогреть оливковое и сливочное масло. Обжарить отбивные на среднем огне с обоих сторон.",
            "mediaId": "wordpress-attachment:13042"
          },
          {
            "sourceIndex": 3,
            "text": "Время жарки зависит от толщины отбивных, примерно 3-4 минуты.",
            "mediaId": "wordpress-attachment:13043"
          },
          {
            "sourceIndex": 4,
            "text": "Как только мясо прожарилось внутри, а снаружи образовалась золотистая корочка, снять мясо со сковороды.",
            "mediaId": "wordpress-attachment:13045"
          }
        ]
      }
    ]
