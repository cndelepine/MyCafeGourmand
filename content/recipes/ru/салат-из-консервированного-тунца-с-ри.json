        "steps": [
          {
            "sourceIndex": 0,
            "text": "Яйца сварить вкрутую (10 минут). Остудить в ледяной воде и почистить от скорлупы.",
            "mediaId": null
          },
          {
            "sourceIndex": 1,
            "text": "Пока варятся яйца, в салатнице растереть вилкой тунец. Добавить рис и хорошо перемешать.",
            "mediaId": null
          },
          {
            "sourceIndex": 2,
            "text": "Помидоры нарезать дольками. Лук почистить и порезать полукольцами.",
            "mediaId": null
          },
          {
            "sourceIndex": 3,
            "text": "Авокадо разрезать на 2 части, удалить косточку, снять кожуру и порезать кубиками.",
            "mediaId": null
          },
          {
            "sourceIndex": 4,
            "text": "Добавить в салатницу помидоры, авокадо, лук и кукурузу. Аккуратно перемешать. Посолить, поперчить и полить салат оливковым маслом.",
            "mediaId": null
          },
          {
            "sourceIndex": 5,
            "text": "Яйца разрезать на 4 части и выложить их сверху на салат. Посыпать мелконарезанным зеленым луком.",
            "mediaId": "wordpress-attachment:8788"
          }
        ]
      }
    ]
