    "instructionGroups": [
      {
        "name": "Ванильное желе",
        "sourceIndex": 0,
        "steps": [
          {
            "sourceIndex": 0,
            "text": "В кастрюле смешать молоко, сливки, сахар и ваниль. Поставить на огонь и нагревать, постоянно помешивая, до полного растворения сахара. Молоко должно стать горячим, но не кипеть. Снять кастрюлю с огня.",
            "mediaId": null
          },
          {
            "sourceIndex": 1,
            "text": "Залить желатин холодной водой и дать постоять несколько минут.",
            "mediaId": null
          },
          {
            "sourceIndex": 2,
            "text": "Добавить разбухший желатин в молочную смесь и хорошо перемешать. Дать постоять 5 минут, затем процедить через сито.",
            "mediaId": null
          },
          {
            "sourceIndex": 3,
            "text": "Разлить по стаканчикам и поставить в холодильник на 2-3 часа.",
            "mediaId": null
          }
        ]
      },
      {
        "name": "Шоколадное желе",
        "sourceIndex": 1,
        "steps": [
          {
            "sourceIndex": 0,
            "text": "В маленькой кастрюльке смешать молоко, какао и сахар. Поставить на огонь и подогреть, постоянно помешивая.",
            "mediaId": null
          },
          {
            "sourceIndex": 1,
            "text": "Залить желатин холодной водой и дать постоять несколько минут.",
            "mediaId": null
          },
          {
            "sourceIndex": 2,
            "text": "Когда молоко достаточно нагрелось, снять кастрюлю с огня и добавить в нее набухший желатин. Хорошо перемешать.",
            "mediaId": null
          },
          {
            "sourceIndex": 3,
            "text": "Процедить и охладить до комнатной температуры.",
            "mediaId": null
          },
          {
            "sourceIndex": 4,
            "text": "Разлить шиколадное молоко по стаканчикам на уже застывший ванильно-молочный слой желе.",
            "mediaId": null
          },
          {
            "sourceIndex": 5,
            "text": "Снова поставить в холодильник на 2-3 часа.",
            "mediaId": "wordpress-attachment:10064"
          }
        ]
      }
    ]
