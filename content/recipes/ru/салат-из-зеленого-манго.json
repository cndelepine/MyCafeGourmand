    "instructionGroups": [
      {
        "name": null,
        "sourceIndex": 0,
        "steps": [
          {
            "sourceIndex": 0,
            "text": "Манго почистить. Мякоть натереть на крупной терке, косточку выкинуть.",
            "mediaId": "wordpress-attachment:12738"
          },
          {
            "sourceIndex": 1,
            "text": "Лук почистить и мелко порезать, чеснок пропустить через чесночницу. Перец чили очень мелко порезать, удалив из него семена. (Перец может быть очень острым, если вы режете его без перчаток, не трогайте потом руками лицо и глаза!)",
            "mediaId": null
          },
          {
            "sourceIndex": 2,
            "text": "В салатнице смешать манго, лук и перец чили. Посолить, поперчить, полить лимонным соком и растительным маслом. Накрыть пищевой пленкой и поставить в холодильник на 2-3 часа.",
            "mediaId": "wordpress-attachment:12739"
          },
          {
            "sourceIndex": 3,
            "text": "Переложить салат в блюдо, посыпать свежей зеленью и подать в охлажденном виде с очищенными креветками.",
            "mediaId": "wordpress-attachment:12741"
          }
        ]
      }
    ]
  },
