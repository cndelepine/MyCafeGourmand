              "unit": null,
              "scalable": false
            },
            "name": "свежей зелени (петрушки, укропа или зеленого лука)",
            "notes": null
          }
        ]
      }
    ],
    "instructionGroups": [
      {
        "name": null,
        "sourceIndex": 0,
        "steps": [
          {
            "sourceIndex": 0,
            "text": "Замороженные грибы обжарить в растительном масле до золотистого цвета.",
            "mediaId": "wordpress-attachment:20528"
          },
          {
            "sourceIndex": 1,
            "text": "Посыпать мукой и потушить еще 1-2 минуты. Снять сковороду с огня.",
            "mediaId": "wordpress-attachment:20532"
          },
          {
            "sourceIndex": 2,
            "text": "Лук и морковь почистить и мелко порезать. (Морковь можно натереть на крупной терке.)",
            "mediaId": "wordpress-attachment:20529"
          },
          {
            "sourceIndex": 3,
            "text": "Обжарить лук и морковь в растительном масле. Посолить и поперчить. Снять сковороду с огня.",
            "mediaId": "wordpress-attachment:20534"
          },
          {
            "sourceIndex": 4,
            "text": "Картофель почистить и порезать кубиками.",
            "mediaId": "wordpress-attachment:20535"
          },
          {
            "sourceIndex": 5,
            "text": "В кастрюлю налить примерно 3 литра воды, положить в нее картофель и поставить на огонь.",
            "mediaId": null
          },
          {
            "sourceIndex": 6,
            "text": "Когда вода закипит, добавить соль и обжаренные грибы.",
            "mediaId": "wordpress-attachment:20536"
          },
          {
            "sourceIndex": 7,
            "text": "Добавить в кастрюлю обжаренные лук-морковь и лавровые листья. Убавить огонь и варить еще 10-15 минут до готовности картофеля. Попробовать суп, если надо, еще немного посолить и поперчить.",
            "mediaId": "wordpress-attachment:20537"
          },
          {
            "sourceIndex": 8,
            "text": "Разлить по тарелкам, посыпать зеленью и подать на стол со сметаной.",
            "mediaId": "wordpress-attachment:20538"
          }
        ]
      }
    ]
  },
