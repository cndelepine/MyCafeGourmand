    "instructionGroups": [
      {
        "name": null,
        "sourceIndex": 0,
        "steps": [
          {
            "sourceIndex": 0,
            "text": "Разогреть духовку до 170С (380 F). Смазать маслом формочки для кексиков или выложить их бумажными формочками.",
            "mediaId": null
          },
          {
            "sourceIndex": 1,
            "text": "Взбить яйца с сахаром и солью.",
            "mediaId": "wordpress-attachment:11755"
          },
          {
            "sourceIndex": 2,
            "text": "Бананы размять вилкой и смешать их с яйцами.",
            "mediaId": "wordpress-attachment:11756"
          },
          {
            "sourceIndex": 3,
            "text": "Добавить миндальную муку и перемешать до однородности.",
            "mediaId": "wordpress-attachment:11757"
          },
          {
            "sourceIndex": 4,
            "text": "Влить растопленное масло и снова перемешать.",
            "mediaId": "wordpress-attachment:11758"
          },
          {
            "sourceIndex": 5,
            "text": "Добавить орехи и шоколадные капли. Хорошо перемешать в последний раз.",
            "mediaId": "wordpress-attachment:11759"
          },
          {
            "sourceIndex": 6,
            "text": "Ложкой выложить тесто в подготовленные формочки для кексиков.",
            "mediaId": "wordpress-attachment:11760"
          },
          {
            "sourceIndex": 7,
            "text": "Выпекать в предварительно разогретой духовке 25-30 минут.",
            "mediaId": "wordpress-attachment:11762"
          }
        ]
      }
    ]
  },
