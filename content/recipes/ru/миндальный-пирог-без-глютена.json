    "instructionGroups": [
      {
        "name": null,
        "sourceIndex": 0,
        "steps": [
          {
            "sourceIndex": 0,
            "text": "Разогреть духовку до 150°С (330°F). Смазать форму маслом или застелить ее дно пергаментной бумагой.",
            "mediaId": null
          },
          {
            "sourceIndex": 1,
            "text": "В чашу миксера положить яйца, сахар и мед.",
            "mediaId": "wordpress-attachment:23589"
          },
          {
            "sourceIndex": 2,
            "text": "Миксером взбить до однородности.",
            "mediaId": "wordpress-attachment:23590"
          },
          {
            "sourceIndex": 3,
            "text": "Добавить миндальную муку. Перемешать.",
            "mediaId": "wordpress-attachment:23591"
          },
          {
            "sourceIndex": 4,
            "text": "Вилкой размять сливочное масло. Добавить маскарпоне и тщательно перемешать.",
            "mediaId": "wordpress-attachment:23588"
          },
          {
            "sourceIndex": 5,
            "text": "Добавить масло с маскарпоне в миндальное тесто и хорошо перемешать.",
            "mediaId": "wordpress-attachment:23592"
          },
          {
            "sourceIndex": 6,
            "text": "Добавить в тесто ваниль и цедру апельсина. Перемешать последний раз.",
            "mediaId": "wordpress-attachment:23607"
          },
          {
            "sourceIndex": 7,
            "text": "Выложить тесто в форму, разровнять поверхность.",
            "mediaId": "wordpress-attachment:23593"
          },
          {
            "sourceIndex": 8,
            "text": "Посыпать миндальными лепестками.",
            "mediaId": "wordpress-attachment:23594"
          },
          {
            "sourceIndex": 9,
            "text": "Поставить в разогретую духовку и выпекать примерно 45 минут. Готовый пирог достать из духовки, охладить и переложить на блюдо. Перед подачей на стол можно слегка посыпать сахарной пудрой.",
            "mediaId": "wordpress-attachment:23595"
          }
        ]
      }
    ]
  },
