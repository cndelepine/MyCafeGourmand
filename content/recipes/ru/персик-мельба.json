    "instructionGroups": [
      {
        "name": null,
        "sourceIndex": 0,
        "steps": [
          {
            "sourceIndex": 0,
            "text": "Разогреть духовку до 180С (390F). Противень застелить пергаментной бумагой.",
            "mediaId": null
          },
          {
            "sourceIndex": 1,
            "text": "Разрезать персики пополам и вынуть косточки. Разместить половинки персиков на противень и посыпать их сахаром.",
            "mediaId": "wordpress-attachment:17872"
          },
          {
            "sourceIndex": 2,
            "text": "Поставить запекаться в духовку примерно на 35 минут. Персики должны стать мягкими, но еще держать свою форму. Готовые персики вынуть из духовки, охладить и аккуратно очистить от кожицы.",
            "mediaId": "wordpress-attachment:17873"
          },
          {
            "sourceIndex": 3,
            "text": "Свежие ягоды помыть, обсушить и перетереть блендером. Чтобы избавиться от маленьких косточек, пропустить через сито.",
            "mediaId": "wordpress-attachment:18080"
          },
          {
            "sourceIndex": 4,
            "text": "В холодные сливки добавить сахар и взбить в нежную пену.",
            "mediaId": "wordpress-attachment:13109"
          },
          {
            "sourceIndex": 5,
            "text": "В индивидуальные формочки или стаканчики положить 1 половинку персика и 1 шарик мороженого.",
            "mediaId": "wordpress-attachment:17874"
          },
          {
            "sourceIndex": 6,
            "text": "Полить ягодным соусом.",
            "mediaId": "wordpress-attachment:17875"
          },
          {
            "sourceIndex": 7,
            "text": "Добавить немного взбитых сливок и посыпать тертым шоколадом. Подавать на стол без промедления! ;)",
            "mediaId": "wordpress-attachment:17876"
          }
        ]
      }
    ]
  },
