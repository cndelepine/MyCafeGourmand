    "instructionGroups": [
      {
        "name": "Бисквит",
        "sourceIndex": 0,
        "steps": [
          {
            "sourceIndex": 0,
            "text": "Разогреть духовку до 180 °C (380F). Противень застелить пергаментной бумагой.",
            "mediaId": null
          },
          {
            "sourceIndex": 1,
            "text": "Миксером взбить яйца с сахаром в густую пену.",
            "mediaId": "wordpress-attachment:19262"
          },
          {
            "sourceIndex": 2,
            "text": "Добавить просеянную муку.",
            "mediaId": "wordpress-attachment:19263"
          },
          {
            "sourceIndex": 3,
            "text": "Аккуратно перемешать при помощи лопатки.",
            "mediaId": "wordpress-attachment:19264"
          },
          {
            "sourceIndex": 4,
            "text": "Равномерно тонким слоем распределить тесто на противень. Поставить в разогретую духовку и выпекать 7-8 минут.",
            "mediaId": "wordpress-attachment:19265"
          },
          {
            "sourceIndex": 5,
            "text": "Достать бисквит из духовки и остудить.",
            "mediaId": "wordpress-attachment:19266"
          },
          {
            "sourceIndex": 6,
            "text": "Застелить разъемную форму пергаментной бумагой.",
            "mediaId": "wordpress-attachment:19261"
          },
          {
            "sourceIndex": 7,
            "text": "Вырезать из бисквита круг нужного размера.",
            "mediaId": "wordpress-attachment:19260"
          },
          {
            "sourceIndex": 8,
            "text": "Поместить, вырезанный бисквит на дно формы.",
            "mediaId": "wordpress-attachment:19271"
          }
        ]
      },
      {
        "name": "Мусс",
        "sourceIndex": 1,
        "steps": [
          {
            "sourceIndex": 0,
            "text": "Ягоды помыть и перетереть с сахаром.",
            "mediaId": "wordpress-attachment:19359"
          },
          {
            "sourceIndex": 1,
            "text": "Пропустить через сито, чтобы избавиться от маленьких косточек.",
            "mediaId": "wordpress-attachment:19360"
          },
          {
            "sourceIndex": 2,
            "text": "В небольшом количестве воды замочить 10 г желатина.",
            "mediaId": "wordpress-attachment:19361"
          },
          {
            "sourceIndex": 3,
            "text": "Добавить в ягодное пюре 125 мл воды и немного подогреть. Снять с огня.",
            "mediaId": "wordpress-attachment:19356"
          },
          {
            "sourceIndex": 4,
            "text": "Добавить к ягодам желатин, хорошо перемешать и остудить при комнатной температуре.",
            "mediaId": "wordpress-attachment:19357"
          },
          {
            "sourceIndex": 5,
            "text": "Холодные сливки взбить в нежную пену.",
            "mediaId": "wordpress-attachment:19358"
          },
          {
            "sourceIndex": 6,
            "text": "Аккуратно соединить взбитые сливки и ягодное пюре.",
            "mediaId": "wordpress-attachment:19362"
          },
          {
            "sourceIndex": 7,
            "text": "Выложить мусс в форму на бисквит. Выровнять поверхность и поставить в холодильник на 3 часа.",
            "mediaId": "wordpress-attachment:19363"
          }
        ]
      },
      {
        "name": "Желе",
        "sourceIndex": 2,
        "steps": [
          {
            "sourceIndex": 0,
            "text": "Замочить 8 г желатина в 3 столовых ложках воды.",
            "mediaId": "wordpress-attachment:19549"
          },
          {
            "sourceIndex": 1,
            "text": "Подогреть половину сока (100 мл) с 1 ч. л. сахара. Соединить подогретый сок и желатин. Хорошо перемешать. Соединить с остальным соком.",
            "mediaId": "wordpress-attachment:19551"
          },
          {
            "sourceIndex": 2,
            "text": "Процедить. Охладить.",
            "mediaId": "wordpress-attachment:19550"
          },
          {
            "sourceIndex": 3,
            "text": "Вылить охлажденный сок в форму на мусс. (Слой желе должен быть всего лишь несколько миллиметров толщиной, возможно у вас останется лишний сок). Пока желе не застыло, украсить ягодами. Поставить в холодильник на 3 часа.",
            "mediaId": "wordpress-attachment:19555"
          },
          {
            "sourceIndex": 4,
            "text": "Чтобы торт достать из формы, проведите лезвием ножа вдоль края. Снять разъемную часть формы и аккуратно переложить на тарелку вместе с пергаментной бумагой. Аккуратно вытянуть бумагу из-под торта.",
            "mediaId": "wordpress-attachment:19554"
          }
        ]
      }
    ]
  },
