    "instructionGroups": [
      {
        "name": null,
        "sourceIndex": 0,
        "steps": [
          {
            "sourceIndex": 0,
            "text": "Разогреть духовку до 220С (410F). Формочки для выпекания смазать маслом. (Силиконовые формочки смазывать не нужно).",
            "mediaId": null
          },
          {
            "sourceIndex": 1,
            "text": "В миске смешать все сухие ингредиенты: миндальную муку, муку, сахарную пудру и разрыхлитель теста.",
            "mediaId": "wordpress-attachment:20328"
          },
          {
            "sourceIndex": 2,
            "text": "Добавить яичные белки, ваниль и перемешать при помощи миксера.",
            "mediaId": "wordpress-attachment:20329"
          },
          {
            "sourceIndex": 3,
            "text": "Добавить растопленное сливочное масло и хорошо перемешать. Тесто получается достаточно жидким.",
            "mediaId": "wordpress-attachment:20330"
          },
          {
            "sourceIndex": 4,
            "text": "Разлить тесто по формочкам.",
            "mediaId": "wordpress-attachment:20327"
          },
          {
            "sourceIndex": 5,
            "text": "Выпекать в разогретой духовке примерно 20 минут до появления золотистой корочки.",
            "mediaId": "wordpress-attachment:20331"
          },
          {
            "sourceIndex": 6,
            "text": "Время выпечки зависит от духовки и от размера ваших формочек.",
            "mediaId": "wordpress-attachment:20332"
          }
        ]
      }
    ]
  },
