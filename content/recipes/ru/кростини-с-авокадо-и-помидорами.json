    "instructionGroups": [
      {
        "name": null,
        "sourceIndex": 0,
        "steps": [
          {
            "sourceIndex": 0,
            "text": "Хорошо разогреть духовку. Разложить ломтики хлеба на противень и сбрызнуть их оливковым маслом.",
            "mediaId": null
          },
          {
            "sourceIndex": 1,
            "text": "Поставить противень в верхнюю часть духовки и жарить хлеб до золотистого цвета, примерно 2-3 минуты с каждой стороны.",
            "mediaId": null
          },
          {
            "sourceIndex": 2,
            "text": "Разрезать пополам 2 очень спелых авокадо, вынуть косточку и мякоть.",
            "mediaId": null
          },
          {
            "sourceIndex": 3,
            "text": "Мякоть положить в мисочку и размять вилкой, перемешивая со сливочным сыром.",
            "mediaId": null
          },
          {
            "sourceIndex": 4,
            "text": "Добавить выдавленный чеснок (или протертый на мелкой терке). Посолить и поперчить.",
            "mediaId": null
          },
          {
            "sourceIndex": 5,
            "text": "Намазать поджаренный хлеб пюре из авокадо.",
            "mediaId": null
          },
          {
            "sourceIndex": 6,
            "text": "Последний авокадо разрезать пополам, вынуть косточку и очистить от кожуры. Разрезать половинки авокадо на ломтики.",
            "mediaId": null
          },
          {
            "sourceIndex": 7,
            "text": "Помидоры нарезать кружочками или дольками.",
            "mediaId": null
          },
          {
            "sourceIndex": 8,
            "text": "Выложить ломтики авокадо и помидора на хлеб. Украсить зеленью.",
            "mediaId": "wordpress-attachment:4048"
