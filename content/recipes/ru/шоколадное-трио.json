        "sourceIndex": 3,
        "items": [
          {
            "sourceIndex": 0,
            "raw": "6-8 ягод свежей малины",
            "quantity": {
              "raw": "6-8 ягод",
              "min": 6,
              "max": 8,
              "unit": "ягод",
              "scalable": true
            },
            "name": "свежей малины",
            "notes": null
          }
        ]
      }
    ],
    "instructionGroups": [
      {
        "name": "Ганаш из черного шоколада",
        "sourceIndex": 0,
        "steps": [
          {
            "sourceIndex": 0,
            "text": "Довести сливки до кипения и залить ими черный шоколад. Подождать 1 минуту и перемешать до однородности.",
            "mediaId": "wordpress-attachment:2866"
          },
          {
            "sourceIndex": 1,
            "text": "Разлить жидкий шоколад по стаканчикам, заполняя их на 1/3. Поставить в холодильник на 1 час.",
            "mediaId": null
          }
        ]
      },
      {
        "name": "Мусс из молочного шоколада",
        "sourceIndex": 1,
        "steps": [
          {
            "sourceIndex": 0,
            "text": "Отделить желтки от белков.",
            "mediaId": null
          },
          {
            "sourceIndex": 1,
            "text": "Молочный шоколад растопить на водяной бане или в микроволновке. Добавить желтки в растопленный шоколад и хорошо перемешать.",
            "mediaId": "wordpress-attachment:2861"
          },
          {
            "sourceIndex": 2,
            "text": "Белки взбить со щепоткой соли в крепкую пену.",
            "mediaId": "wordpress-attachment:2862"
          },
          {
            "sourceIndex": 3,
            "text": "Аккуратно соединить взбитые белки с шоколадом.",
            "mediaId": "wordpress-attachment:2863"
          },
          {
            "sourceIndex": 4,
            "text": "Достать стаканчики из холодильника, ганаш уже должен достаточно затвердеть. Распределить мусс по стаканчикам с помощью кулинарного пакета или маленькой ложечки. Поставить снова в холодильник на 1 час.",
            "mediaId": null
          }
        ]
      },
      {
        "name": "Мусс из белого шоколада",
        "sourceIndex": 2,
        "steps": [
          {
            "sourceIndex": 0,
            "text": "Довести сливки до кипения и залить ими белый шоколад. Подождать 1-2 минуты, чтобы шоколад полностью растаял.",
            "mediaId": "wordpress-attachment:2859"
          },
          {
            "sourceIndex": 1,
            "text": "Перемешать веничком до однородности. Поставить жидкий белый шоколад в холодильник примерно на 45 минут. Шоколад должен полностью охладиться, но еще оставаться жидким.",
            "mediaId": "wordpress-attachment:2860"
          },
          {
            "sourceIndex": 2,
            "text": "Взбить охлажденный шоколад в нежную пену.",
            "mediaId": "wordpress-attachment:2864"
          },
          {
            "sourceIndex": 3,
            "text": "С помощью кулинарного пакета или маленькой ложечки распределить мусс по стаканчикам.",
            "mediaId": "wordpress-attachment:2865"
          },
          {
            "sourceIndex": 4,
            "text": "Поставить десерт в холодильник минимум на 3 часа, а лучше на 6 часов.",
            "mediaId": null
          },
          {
            "sourceIndex": 5,
            "text": "Перед подачей на стол, каждый стаканчик украсить ягодкой. Если стаканчики очень маленькие, красивее будет разрезать ягоды на 2 части.",
            "mediaId": null
          }
        ]
      }
    ]
  },
