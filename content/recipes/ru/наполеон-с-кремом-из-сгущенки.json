    "instructionGroups": [
      {
        "name": "Коржи",
        "sourceIndex": 0,
        "steps": [
          {
            "sourceIndex": 0,
            "text": "Полстакана воды смешать лимонным соком и одним яйцом.",
            "mediaId": null
          },
          {
            "sourceIndex": 1,
            "text": "В большой миске порубить ножом холодное масло (или маргарин), постепенно посыпая мукой и поливая жидкостью с яйцом.",
            "mediaId": "wordpress-attachment:786"
          },
          {
            "sourceIndex": 2,
            "text": "Сформировать из теста одну большую колбаску.",
            "mediaId": "wordpress-attachment:911"
          },
          {
            "sourceIndex": 3,
            "text": "Затем разделить ее на 7-8 частей, скатать шарики и положить в холодильник минимум на 1 час (можно оставить на всю ночь).",
            "mediaId": "wordpress-attachment:767"
          },
          {
            "sourceIndex": 4,
            "text": "Каждый шарик посыпать мукой и раскатать на пергаментной бумаге или фольге в очень тонкий корж. Наколоть вилкой.",
            "mediaId": "wordpress-attachment:787"
          },
          {
            "sourceIndex": 5,
            "text": "Поставить в духовку, разогретую до 200 С, примерно на 10 минут. Выпекать до красивого золотистого цвета.",
            "mediaId": null
          },
          {
            "sourceIndex": 6,
            "text": "Когда корж поджарился, вырезать из него нужную форму, пока он еще не остыл. Я использую тарелку.",
            "mediaId": "wordpress-attachment:788"
          },
          {
            "sourceIndex": 7,
            "text": "Из обрезков сделать крошки для обсыпки: размять пальцами или перемолоть в блендере.",
            "mediaId": "wordpress-attachment:789"
          }
        ]
      },
      {
        "name": "Крем",
        "sourceIndex": 1,
        "steps": [
          {
            "sourceIndex": 0,
            "text": "Размягченное сливочное масло взбить миксером, добавить сгущенку и смешать до однородного состояния.",
            "mediaId": "wordpress-attachment:790"
          }
        ]
      },
      {
        "name": "Сборка торта",
        "sourceIndex": 2,
        "steps": [
          {
            "sourceIndex": 0,
            "text": "Каждый корж смазать кремом и посыпать орешками.",
            "mediaId": "wordpress-attachment:791"
          },
          {
            "sourceIndex": 1,
            "text": "Последний верхний корж смазать кремом, посыпать орехами и обсыпать приготовленными крошками. Также обсыпать крошками бока торта.",
            "mediaId": "wordpress-attachment:792"
          },
          {
            "sourceIndex": 2,
            "text": "Поставить в холодильник на 8 часов, чтобы коржи хорошо пропитались кремом. Перед подачей на стол украсить торт целыми орехами.",
            "mediaId": "wordpress-attachment:642"
          }
        ]
      }
    ]
  },
