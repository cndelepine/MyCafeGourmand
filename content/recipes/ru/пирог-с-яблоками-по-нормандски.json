    "instructionGroups": [
      {
        "name": null,
        "sourceIndex": 0,
        "steps": [
          {
            "sourceIndex": 0,
            "text": "Духовку разогреть до 180 С. Слоеное тесто раскатать и выложить в круглую форму, на пергаментную бумагу. Сделать в тесте дырочки вилкой.",
            "mediaId": null
          },
          {
            "sourceIndex": 1,
            "text": "Поставить выпекаться в духовку примерно на 12-15 минут.",
            "mediaId": null
          },
          {
            "sourceIndex": 2,
            "text": "Яблоки почистить, вырезать сердцевину и нарезать тонкими ломтиками. Сбрызнуть лимонным соком.",
            "mediaId": null
          },
          {
            "sourceIndex": 3,
            "text": "Красиво выложить ломтики яблок на тесто.",
            "mediaId": null
          },
          {
            "sourceIndex": 4,
            "text": "Взбить яйца с сахаром. Добавить кальвадос, сметану и миндальную муку. Хорошо все перемешать.",
            "mediaId": null
          },
          {
            "sourceIndex": 5,
            "text": "Равномерно залить яблоки этой миндальной смесью.",
            "mediaId": null
          },
          {
            "sourceIndex": 6,
            "text": "Поставить в духовку и выпекать 15 минут.",
            "mediaId": null
          },
          {
            "sourceIndex": 7,
            "text": "Посыпать ломтиками миндаля и продолжать выпекать еще примерно 30 минут до появления аппетитной золотой корочки.",
            "mediaId": null
          },
          {
            "sourceIndex": 8,
            "text": "Остудить пирог и посыпать сахарной пудрой.",
            "mediaId": "wordpress-attachment:1048"
          }
        ]
      }
    ]
