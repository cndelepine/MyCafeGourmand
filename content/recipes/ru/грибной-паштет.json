            "name": "оливкового масла",
            "notes": null
          },
          {
            "sourceIndex": 6,
            "raw": "Зеленый лук по желанию",
            "quantity": null,
            "name": "Зеленый лук",
            "notes": "по желанию"
          }
        ]
      }
    ],
    "instructionGroups": [
      {
        "name": null,
        "sourceIndex": 0,
        "steps": [
          {
            "sourceIndex": 0,
            "text": "Грибы хорошо помыть, обсушить и порезать на ломтики.",
            "mediaId": "wordpress-attachment:9074"
          },
          {
            "sourceIndex": 1,
            "text": "Лук почистить и порезать полукольцами.",
            "mediaId": "wordpress-attachment:9075"
          },
          {
            "sourceIndex": 2,
            "text": "Чеснок почистить и измельчить.",
            "mediaId": "wordpress-attachment:9077"
          },
          {
            "sourceIndex": 3,
            "text": "В большой сковороде разогреть 5 ст.л. оливкового масла и обжарить в нем грибы на среднем огне, в течение примерно 15 минут, регулярно помешивая. Снять сковороду с огня и дать грибам остыть.",
            "mediaId": null
          },
          {
            "sourceIndex": 4,
            "text": "В небольшой сковороде разогреть оставшиеся 2 ст.л. оливкового масла и обжарить в нем лук на среднем огне до золотистого цвета.",
            "mediaId": "wordpress-attachment:9076"
          },
          {
            "sourceIndex": 5,
            "text": "Добавить к обжаренному луку чеснок и продолжать жарить еще 1 минуту. Снять сковороду с огня и остудить.",
            "mediaId": "wordpress-attachment:9078"
          },
          {
            "sourceIndex": 6,
            "text": "Положить половину поджаренных грибов и лук с чесноком в блендер и хорошо перемешать.",
            "mediaId": "wordpress-attachment:9079"
          },
          {
            "sourceIndex": 7,
            "text": "Добавить в блендер оставшиеся грибы и сливочный сыр. Перемешать.",
            "mediaId": "wordpress-attachment:9080"
          },
          {
            "sourceIndex": 8,
            "text": "Добавить соль и перец. Хорошо перемешать деревянной ложкой.",
            "mediaId": "wordpress-attachment:9081"
          },
          {
            "sourceIndex": 9,
            "text": "Переложить паштет в блюдо для подачи. Украсить целыми ломтиками грибов и зеленым луком.",
            "mediaId": "wordpress-attachment:9083"
          }
        ]
      }
    ]
  },
