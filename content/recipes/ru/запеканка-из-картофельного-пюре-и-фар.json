    "instructionGroups": [
      {
        "name": null,
        "sourceIndex": 0,
        "steps": [
          {
            "sourceIndex": 0,
            "text": "Картофель почистить, разрезать на кусочки средней величины и отварить в подсоленной воде до готовности. (В зависимости от сорта картофеля, 15-25 минут.) Слить воду.",
            "mediaId": "wordpress-attachment:19911"
          },
          {
            "sourceIndex": 1,
            "text": "Добавить 50 г сливочного масла и размять в пюре. Добавить подогретое молоко. Если надо, посолить еще. Пюре должно получиться нежное, но не жидкое.",
            "mediaId": "wordpress-attachment:19912"
          },
          {
            "sourceIndex": 2,
            "text": "Лук и чеснок почистить и мелко порезать.",
            "mediaId": "wordpress-attachment:19913"
          },
          {
            "sourceIndex": 3,
            "text": "Обжарить в 30 г сливочного масла.",
            "mediaId": "wordpress-attachment:19914"
          },
          {
            "sourceIndex": 4,
            "text": "Добавить фарш, хорошо перемешать и жарить до готовности. Посолить, поперчить.",
            "mediaId": "wordpress-attachment:19915"
          },
          {
            "sourceIndex": 5,
            "text": "Снять сковороду с огня и немного остудить. Добавить сырое яйцо и перемешать.",
            "mediaId": "wordpress-attachment:19916"
          },
          {
            "sourceIndex": 6,
            "text": "Перетереть фарш в блендере.",
            "mediaId": "wordpress-attachment:19917"
          },
          {
            "sourceIndex": 7,
            "text": "Разогреть духовку до 180 С. Форму для выпекания смазать маслом.",
            "mediaId": null
          },
          {
            "sourceIndex": 8,
            "text": "Выложить в форму половину картофельного пюре (тонким слоем). На картофельное пюре выложить фарш. Можно приправить вашими любимыми специями или свежими травами. (На фото - паприка).",
            "mediaId": "wordpress-attachment:19918"
          },
          {
            "sourceIndex": 9,
            "text": "Оставшееся пюре выложить на фарш. Положить кусочки оставшегося масла и посыпать тертым сыром.",
            "mediaId": "wordpress-attachment:19919"
          },
          {
            "sourceIndex": 10,
            "text": "Поставить в духовку примерно на 25 минут, до появления аппетитной корочки. Подавать на стол в горячем виде.",
            "mediaId": "wordpress-attachment:19920"
          }
        ]
      }
    ]
  },
